{
  "name": "control-everything",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture.mjs",
    "voice": "python scripts/narrate.py",
    "fonts": "python scripts/prepare-assets.py",
    "build": "node scripts/build.mjs",
    "dev": "npx --yes hyperframes@0.8.159 preview",
    "check": "npx --yes hyperframes@0.8.159 check",
    "render": "npx --yes hyperframes@0.8.159 render --fps 30 --quality delivery --output renders/intro.mp4",
    "publish": "npx --yes hyperframes@0.8.159 publish"
  },
  "devDependencies": {
    "gsap": "^3.15.0",
    "playwright": "^1.64.1"
  }
}
