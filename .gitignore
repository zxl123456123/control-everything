# Local environments, caches and generated evidence
.venv/
.exe/
__pycache__/
*.py[cod]
node_modules/
/work/
/native/observer/target/
/build/
/dist/
*.egg-info/
/web/workbench-engine/out/
/web/workbench-engine/.build/
/web/workbench-engine/.cache/
/web/workbench-engine/mobile/.expo/
/web/workbench-engine/mobile/dist/
/web/workbench-engine/mobile/android/
/web/workbench-engine/mobile/ios/
/web/workbench-engine/src/packages/process-host/dist/
/web/workbench-engine/native/windows-cli-launcher/target/

# Publish only reviewed project documentation; keep development records local.
/docs/*
!/docs/README.md
!/docs/architecture/
/docs/architecture/*
!/docs/architecture/architecture.md
!/docs/architecture/workbench-contract.md
!/docs/guides/
/docs/guides/*
!/docs/guides/usage.md
!/docs/guides/integrations.md
!/docs/guides/windows.md
!/docs/guides/development-files.md
!/docs/guides/EMBEDDING.md
!/docs/guides/PETS_INTEGRATION.md
!/docs/examples/
# Reviewed workbench identity/device/Caddy examples remain public; exact owners are
# enumerated in tools/scripts/check_architecture.py, never real service configuration.
/docs/current/
/docs/archive/

# Local video source and renders are not publication candidates
/videos/

# Local configuration and user data
/.claude/
/.codex/*
/.env
/.env.*
!/.env.example
/progress-registry.json
/progress-manual.json
/progress-todos.json
*.sqlite
*.sqlite3
*.sqlite3-*
*.sqlite3.*
*.sqlite-*
*.log

