# Control Everything 远程账号部署 —— 配置模板（仅含占位值，不含任何真实秘密）。
# install.sh 会复制到 /etc/ce-remote/ce-remote.env（权限 0600），并为所有 CHANGE_ME_AT_INSTALL
# 自动生成随机值。请勿提交真实的 env 文件。
#
# 解耦约定：与具体身份提供方（IdP）有关的值（issuer、client id、realm、登录退出地址、
# 公开路径白名单）只出现在本文件的 “IdP 区块”；Caddyfile、systemd 单元和 hub 配置生成逻辑
# 只读取下面的通用变量，不含任何 IdP 专有字样。

# ---------- 通用：公网入口 ----------
# 服务器公网 IPv4（install.sh 会尝试自动探测；这里是文档示例地址 TEST-NET-3，不是真实地址）。
CE_PUBLIC_IP=203.0.113.10
# 对外唯一来源。无域名时就是 https://<公网 IP>，不能带端口。
CE_PUBLIC_ORIGIN=https://203.0.113.10
# 容器镜像的注册表前缀。留空 = 官方源；国内可填镜像前缀（须以 / 结尾），例如 docker.1ms.run/
# 对 quay.io 上的镜像单独设置。镜像站可用性未在真实服务器核实，请先 docker pull 试一次。
CE_REGISTRY_DOCKERHUB=
CE_REGISTRY_QUAY=quay.io/

# ---------- 通用：本机端口（全部仅监听 127.0.0.1，公网只有 Caddy 的 80/443 和 sshd 的 2223） ----------
CE_OAUTH2_PROXY_ADDR=127.0.0.1:18868
CE_HUB_ADDR=127.0.0.1:18869
CE_IDP_UPSTREAM=127.0.0.1:18080
# 手机 App 自定义回调 scheme（反向域名风格，部署者自定；与 App 内置值必须一致）。
CE_MOBILE_SCHEME=com.example.workbench.app

# ---------- 通用：秘密（CHANGE_ME_AT_INSTALL 由 install.sh 生成，不要手填弱口令） ----------
CE_ROUTE_PROOF=CHANGE_ME_AT_INSTALL
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_AT_INSTALL
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME_AT_INSTALL
CE_HUB_INTROSPECTION_CLIENT_SECRET=CHANGE_ME_AT_INSTALL
CE_DIRECTORY_CLIENT_SECRET=CHANGE_ME_AT_INSTALL

# =====================================================================
# IdP 区块 —— 换身份提供方只改这里（以及 compose 里的 idp-*.yml），见 README.zh.md “更换 IdP”。
# =====================================================================
# issuer 必须与 IdP 签发的 iss 完全一致；hub 要求 https、无结尾斜杠。
CE_OIDC_ISSUER=https://203.0.113.10/realms/workbench
CE_OIDC_PROVIDER=keycloak-oidc
CE_OIDC_WEB_CLIENT_ID=workbench-web
CE_OIDC_HUB_CLIENT_ID=workbench-hub
CE_OIDC_DIRECTORY_CLIENT_ID=workbench-user-directory
CE_OIDC_LOGOUT_URL=https://203.0.113.10/realms/workbench/protocol/openid-connect/logout?client_id=workbench-web&id_token_hint={id_token}
# 允许经公网转发给 IdP 的路径（空格分隔）。其余路径（管理控制台、master realm）一律 404。
# 最后两项是 hub 读取成员目录所需的只读用户列表接口，仍须 Bearer 令牌才能访问。
CE_IDP_PUBLIC_PATHS=/realms/workbench /realms/workbench/* /resources/* /admin/realms/workbench/users /admin/realms/workbench/users/*

# ---------- Keycloak 专用（仅 idp-keycloak.yml 使用） ----------
KC_IMAGE_TAG=26.8.1
# 容器总内存上限，以及 JVM 堆/非堆上限。预算见 README.zh.md “内存预算”。
KC_MEM_LIMIT=768m
KC_JAVA_HEAP=-Xms128m -Xmx288m
KC_JAVA_OPTS=-XX:-UseG1GC -XX:+UseSerialGC -XX:MaxMetaspaceSize=192m -XX:MaxDirectMemorySize=48m -XX:ReservedCodeCacheSize=48m -Xss512k
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_INSTALL
KC_DB_PASSWORD=CHANGE_ME_AT_INSTALL
# Postgres（Keycloak 专用实例，配小共享缓冲）
PG_MEM_LIMIT=160m
PG_SHARED_BUFFERS=24MB
