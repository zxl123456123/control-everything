+import "./lifecycle.test-support.js";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { EventDispatcher } from "@larksuiteoapi/node-sdk";
+import { createDeferred } from "openclaw/plugin-sdk/extension-shared";
+import { createRuntimeEnv } from "openclaw/plugin-sdk/plugin-test-runtime";
+import { closeOpenClawStateDatabaseAsync } from "openclaw/plugin-sdk/sqlite-runtime-testing";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { resolveFeishuRuntimeAccount } from "./accounts.js";
+import * as cardAction from "./card-action.js";
+import { FeishuConfigSchema } from "./config-schema.js";
+import {
+  getFeishuLifecycleTestMocks,
+  resetFeishuLifecycleTestMocks,
+} from "./lifecycle.test-support.js";
+import { monitorSingleAccount } from "./monitor.account.js";
+import { getFeishuRuntime } from "./runtime.js";
+import {
+  createFeishuLifecycleConfig,
+  installFeishuLifecycleReplyRuntime,
+} from "./test-support/lifecycle-test-support.js";
+
+const mocks = getFeishuLifecycleTestMocks();
+const decision = {
+  namespace: "control-everything.automation.v1",
+  decision_id: "decision",
+  task_id: "task",
+  delivery_id: "delivery",
+  expected_revision: 1,
+  progress_revision: 2,
+  verdict: "approved",
+};
+const ingress = { hubOrigin: "https://hub.example.test", producerId: "father", chatId: "oc-chat" };
+const originalStateDir = process.env.OPENCLAW_STATE_DIR;
+let stateDir: string;
+let controller: AbortController;
+let monitoring: Promise<void> | undefined;
+
+function envelope(eventId = "evt-card") {
+  return {
+    schema: "2.0",
+    header: { event_id: eventId, event_type: "card.action.trigger" },
+    event: {
+      token: "card-token-is-not-the-event-id",
+      operator: { open_id: "ou-operator" },
+      context: { open_chat_id: "oc-chat", open_message_id: "om-card" },
+      action: { tag: "button", value: { ...decision } },
+    },
+  };
+}
+
+async function startMonitor(configured = true, producerToken = "producer-fixture") {
+  const cfg = createFeishuLifecycleConfig({
+    accountId: "father",
+    appId: "app",
+    appSecret: "fixture",
+    accountConfig: configured
+      ? {
+          automationIngress: ingress,
+          automationProducerToken: producerToken,
+        }
+      : {},
+  });
+  cfg.channels!.feishu = FeishuConfigSchema.parse(cfg.channels!.feishu);
+  const account = resolveFeishuRuntimeAccount({ cfg, accountId: "father" });
+  const runtime = installFeishuLifecycleReplyRuntime({
+    resolveAgentRouteMock: mocks.resolveAgentRouteMock,
+    dispatchReplyFromConfigMock: mocks.dispatchReplyFromConfigMock,
+    withReplyDispatcherMock: mocks.withReplyDispatcherMock,
+    storePath: path.join(stateDir, "sessions.json"),
+  });
+  runtime.config.current = vi.fn(() => cfg);
+  const sdk = new EventDispatcher({});
+  mocks.createEventDispatcherMock.mockReturnValue(sdk);
+  const started = createDeferred<EventDispatcher>();
+  mocks.monitorWebSocketMock.mockImplementationOnce(
+    async (params: { eventDispatcher: EventDispatcher }) => {
+      started.resolve(params.eventDispatcher);
+      if (!controller.signal.aborted) {
+        await new Promise<void>((resolve) =>
+          controller.signal.addEventListener("abort", () => resolve(), { once: true }),
+        );
+      }
+    },
+  );
+  monitoring = monitorSingleAccount({
+    cfg,
+    account,
+    runtime: createRuntimeEnv(),
+    abortSignal: controller.signal,
+    botOpenIdSource: { kind: "prefetched", botOpenId: "ou-bot" },
+  });
+  void monitoring.catch(started.reject);
+  return {
+    sdk,
+    transport: await started.promise,
+    queue: runtime.state.openChannelIngressQueue({ accountId: "father" }),
+  };
+}
+
+beforeEach(async () => {
+  resetFeishuLifecycleTestMocks();
+  ingress.producerId = "father";
+  ingress.chatId = "oc-chat";
+  stateDir = await fs.mkdtemp(path.join(os.tmpdir(), "feishu-automation-"));
+  process.env.OPENCLAW_STATE_DIR = stateDir;
+  controller = new AbortController();
+});
+
+afterEach(async () => {
+  controller.abort();
+  await monitoring;
+  monitoring = undefined;
+  await closeOpenClawStateDatabaseAsync();
+  vi.restoreAllMocks();
+  if (originalStateDir === undefined) delete process.env.OPENCLAW_STATE_DIR;
+  else process.env.OPENCLAW_STATE_DIR = originalStateDir;
+  await fs.rm(stateDir, { recursive: true, force: true });
+});
+
+describe("automation cards through the account monitor", () => {
+  it("awaits the Hub receipt before completing the real durable SDK event", async () => {
+    const received = createDeferred<void>();
+    const response = createDeferred<Response>();
+    const fetch = vi.spyOn(globalThis, "fetch").mockImplementation(async () => {
+      received.resolve();
+      return response.promise;
+    });
+    const ordinary = vi.spyOn(cardAction, "handleFeishuCardAction").mockResolvedValue();
+    const { transport, queue } = await startMonitor();
+    const data = envelope();
+    await transport.invoke(data, { needCheck: false });
+    await vi.waitFor(() => expect(fetch).toHaveBeenCalledTimes(1));
+    await received.promise;
+    expect(await queue.listClaims()).toHaveLength(1);
+    expect(fetch.mock.calls[0]?.[0]).toBe(
+      "https://hub.example.test/remote/producer/automation/receive",
+    );
+    const options = fetch.mock.calls[0]?.[1];
+    expect(options?.redirect).toBe("error");
+    expect(JSON.parse(options?.body as string)).toEqual({
+      producer_id: "father",
+      event_id: "evt-card",
+      chat_id: "oc-chat",
+      message_id: "om-card",
+      actor_open_id: "ou-operator",
+      decision,
+    });
+    expect(ordinary).not.toHaveBeenCalled();
+    response.resolve(
+      new Response(JSON.stringify({ id: "receipt", state: "pending" }), { status: 200 }),
+    );
+    await vi.waitFor(async () =>
+      expect(await queue.enqueue("evt-card", {})).toMatchObject({ kind: "completed" }),
+    );
+    await transport.invoke(data, { needCheck: false });
+    expect(fetch).toHaveBeenCalledTimes(1);
+  });
+
+  it("propagates CE failure through real SDK invoke even with default fire-and-forget", async () => {
+    vi.spyOn(globalThis, "fetch").mockRejectedValue(new Error("synthetic transport unavailable"));
+    const ordinary = vi.spyOn(cardAction, "handleFeishuCardAction").mockResolvedValue();
+    const { sdk } = await startMonitor();
+    await expect(sdk.invoke(envelope(), { needCheck: false })).rejects.toThrow();
+    expect(ordinary).not.toHaveBeenCalled();
+  });
+});
+
+import { receiveAutomationCard } from "./automation-card-ingress.js";
+
+describe("automation receipt boundary", () => {
+  it.each(["pending", "acknowledged"])("accepts durable %s receipts", async (state) => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      new Response(JSON.stringify({ id: "receipt", state })),
+    );
+    const sdk = new EventDispatcher({});
+    sdk.register({
+      "card.action.trigger": (data) =>
+        receiveAutomationCard({
+          data,
+          config: { ...ingress, token: "fixture" },
+          active: () => true,
+          signal: controller.signal,
+        }),
+    });
+    await expect(sdk.invoke(envelope(), { needCheck: false })).resolves.toBeUndefined();
+  });
+  it.each(["approved", "", "unknown"])("rejects nondurable receipt %s", async (state) => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      new Response(JSON.stringify({ id: "receipt", state })),
+    );
+    const sdk = new EventDispatcher({});
+    sdk.register({
+      "card.action.trigger": (data) =>
+        receiveAutomationCard({
+          data,
+          config: { ...ingress, token: "fixture" },
+          active: () => true,
+          signal: controller.signal,
+        }),
+    });
+    await expect(sdk.invoke(envelope(), { needCheck: false })).rejects.toThrow(
+      "Invalid automation card ingress",
+    );
+  });
+  it("sanitizes malformed response JSON", async () => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(new Response("private-response-secret"));
+    const sdk = new EventDispatcher({});
+    sdk.register({
+      "card.action.trigger": (data) =>
+        receiveAutomationCard({
+          data,
+          config: { ...ingress, token: "fixture" },
+          active: () => true,
+          signal: controller.signal,
+        }),
+    });
+    await expect(sdk.invoke(envelope(), { needCheck: false })).rejects.toThrow(
+      "Invalid automation card ingress",
+    );
+  });
+});
+
+it("does not adopt an in-flight durable card after account stop", async () => {
+  const response = createDeferred<Response>();
+  const fetch = vi.spyOn(globalThis, "fetch").mockImplementation(async () => response.promise);
+  const { transport, queue } = await startMonitor();
+  await transport.invoke(envelope("stopped-event"), { needCheck: false });
+  await vi.waitFor(() => expect(fetch).toHaveBeenCalledTimes(1));
+  controller.abort();
+  response.resolve(new Response(JSON.stringify({ id: "receipt", state: "pending" })));
+  await monitoring;
+  expect(await queue.enqueue("stopped-event", {})).not.toMatchObject({ kind: "completed" });
+});
+
+for (const kind of ["decision", "binding"] as const) {
+  it.skipIf(!process.env.CE_CALLER_LOOPBACK)(
+    `delivers ${kind} through real Hub HTTP and SQLite`,
+    async () => {
+      ingress.producerId = "producer-a";
+      ingress.chatId = "chat-a";
+      const syntheticProducerToken = "synthetic-producer-" + "a".repeat(43);
+      const originalFetch = globalThis.fetch;
+      const delivered = createDeferred<void>();
+      const release = createDeferred<void>();
+      const fetch = vi.spyOn(globalThis, "fetch").mockImplementation(async (url, options) => {
+        try {
+          expect(url).toBe("https://hub.example.test/remote/producer/automation/receive");
+          const requestBody = JSON.parse(String(options?.body));
+          const headers = new Headers(options?.headers);
+          if (requestBody.producer_id !== "producer-a")
+            throw new Error("Synthetic Hub producer mismatch");
+          if (headers.get("Authorization") !== `Bearer ${syntheticProducerToken}`)
+            throw new Error("Synthetic Hub credential mismatch");
+          const response = await originalFetch(
+            `${process.env.CE_CALLER_LOOPBACK}/remote/producer/automation/receive`,
+            options,
+          );
+          if (response.status !== 200) throw new Error(`Synthetic Hub HTTP ${response.status}`);
+          delivered.resolve();
+          await release.promise;
+          return response;
+        } catch (error) {
+          delivered.reject(
+            new Error(
+              error instanceof Error &&
+                /^Synthetic Hub (HTTP \d+|producer mismatch|credential mismatch)$/.test(
+                  error.message,
+                )
+                ? error.message
+                : "Synthetic Hub transport or request assertion failed",
+            ),
+          );
+          throw error;
+        }
+      });
+      // Attach the rejection observer before admitting work to the asynchronous drain.
+      const deliveryResult = delivered.promise.then(
+        () => null,
+        (error: unknown) => error,
+      );
+      const { transport, queue } = await startMonitor(true, syntheticProducerToken);
+      const eventId = kind === "decision" ? "real-hub-event" : "real-hub-identity-event";
+      const data = envelope(eventId);
+      if (kind === "binding")
+        data.event.action.value = {
+          namespace: "control-everything.identity.v1",
+          challenge_id: "challenge",
+          nonce: "nonce",
+        } as unknown as typeof decision;
+      data.event.context.open_chat_id = "chat-a";
+      await transport.invoke(data, { needCheck: false });
+      try {
+        await vi.waitFor(() => expect(fetch).toHaveBeenCalled());
+        const deliveryError = await deliveryResult;
+        if (deliveryError) throw deliveryError;
+        expect(await queue.listClaims()).toHaveLength(1);
+      } finally {
+        release.resolve();
+      }
+      await vi.waitFor(async () =>
+        expect(await queue.enqueue(eventId, {})).toMatchObject({ kind: "completed" }),
+      );
+      await transport.invoke(data, { needCheck: false });
+    },
+  );
+}
+
+it.each(["verdict", "state"])("rejects JSON array coercion for %s", async (field) => {
+  vi.spyOn(globalThis, "fetch").mockResolvedValue(
