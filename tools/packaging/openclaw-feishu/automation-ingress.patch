+});
+
+const binding = {
+  namespace: "control-everything.identity.v1",
+  challenge_id: "challenge",
+  nonce: "nonce",
+};
+it("durably receives identity through SDK monitor before adoption", async () => {
+  const response = createDeferred<Response>();
+  const fetch = vi.spyOn(globalThis, "fetch").mockImplementation(async () => response.promise);
+  const ordinary = vi.spyOn(cardAction, "handleFeishuCardAction").mockResolvedValue();
