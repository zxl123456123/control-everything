+import { isRecord } from "openclaw/plugin-sdk/channel-secret-basic-runtime";
+import type { ResolvedFeishuAccount } from "./types.js";
+
+
+export function hubOriginAllowed(value: string): boolean {
+  const url = URL.parse(value);
+  if (!url || url.username || url.password || value !== url.origin) return false;
+  if (url.protocol === "https:") return true;
+  return url.protocol === "http:" && url.hostname === "127.0.0.1" && url.port !== "";
+}
+
+export function isAutomationCard(data: unknown): boolean {
+  return (
+    isRecord(data) &&
+    isRecord(data.action) &&
+    isRecord(data.action.value) &&
+    ["control-everything.automation.v1", "control-everything.identity.v1"].includes(
+      data.action.value.namespace as string,
+    )
+  );
+}
+
+export async function receiveAutomationCard(params: {
+  data: unknown;
+  config: ResolvedFeishuAccount["automationIngress"];
+  active: () => boolean;
+  signal?: AbortSignal;
+}): Promise<void> {
+  const { data, config, active, signal } = params;
+  const fail = () => {
+    throw new Error("Invalid automation card ingress");
+  };
+  if (
+    !config ||
+    !isRecord(data) ||
+    !isRecord(data.context) ||
+    !isRecord(data.operator) ||
+    !isRecord(data.action) ||
+    !isRecord(data.action.value)
+  )
+    return fail();
+  const text = (value: unknown) => (typeof value === "string" ? value.trim() : "");
+  const chat = text(data.context.open_chat_id) || text(data.context.chat_id);
+  if (
+    text(data.context.open_chat_id) &&
+    text(data.context.chat_id) &&
+    text(data.context.open_chat_id) !== text(data.context.chat_id)
+  )
+    return fail();
+  const eventId = text(data.event_id);
+  const message = text(data.context.open_message_id);
+  const actor = text(data.operator.open_id);
+  const decision = data.action.value;
+  const names = Object.keys(decision);
+  const exact = (expected: string[]) =>
+    names.length === expected.length && expected.every((key) => names.includes(key));
+  const bounded = (key: string) => {
+    const item = text(decision[key]);
+    return item.length > 0 && item.length <= 256;
+  };
+  const revision = (key: string) =>
+    Number.isSafeInteger(decision[key]) && Number(decision[key]) >= 0;
+  const plan = "按已审方案实现";
+  const assignmentText = "请做这个任务";
+  const heldReasons = new Set([
+    "integration_target_required",
+    "integration_retest_failed",
+    "repair_budget_exhausted",
+    "verification_not_configured",
+    "acceptance_rejected",
+    "human_decision_required",
+    "plan_revision_limit",
+    "requirement_changed",
+    "independent_review_required",
+    "project_directory_changed",
+    "project_unavailable",
+    "verification_evidence_invalid",
+    "invalid_code_review",
+    "model_unobserved",
+    "model_mismatch",
+    "verification_unknown",
+    "verification_checker_unavailable",
+    "read_only_result_unverified",
+    "verification_callback_unavailable",
+    "automation_delivery_unverified",
+    "automation_project_busy",
+    "invalid_planning_result",
+    "automation_plan_changed",
+    "read_only_launch_args_unsupported",
+    "read_only_command_override_unsupported",
+  ]);
+  const decisionKeys = [
+    "namespace",
+    "decision_id",
+    "task_id",
+    "delivery_id",
+    "expected_revision",
+    "progress_revision",
+    "verdict",
+  ];
+  let posted: Record<string, unknown> | undefined;
+  if (
+    decision.namespace === "control-everything.identity.v1" &&
+    exact(["namespace", "challenge_id", "nonce"]) &&
+    ["challenge_id", "nonce"].every(bounded)
+  )
+    posted = { binding: decision };
+  else if (
+    decision.namespace === "control-everything.automation.v1" &&
+    (exact(decisionKeys) || exact([...decisionKeys, "flow_id"])) &&
+    ["decision_id", "task_id", "delivery_id"].every((key) => text(decision[key])) &&
+    (!("flow_id" in decision) || bounded("flow_id")) &&
+    ["expected_revision", "progress_revision"].every(revision) &&
+    typeof decision.verdict === "string" &&
+    ["approved", "changes_requested", "rejected"].includes(decision.verdict)
+  ) {
+    const body = { ...decision };
+    delete body.flow_id;
+    posted = { decision: body };
+  } else if (
+    decision.namespace === "control-everything.automation.v1" &&
+    exact(["namespace", "task_id", "flow_id", "requirement_revision", "choice"]) &&
+    bounded("task_id") &&
+    bounded("flow_id") &&
+    revision("requirement_revision") &&
+    decision.choice === plan
+  )
+    posted = {
+      plan_release: {
+        namespace: decision.namespace,
+        flow_id: text(decision.flow_id),
+        text: plan,
+        requirement_revision: decision.requirement_revision,
+      },
+    };
+  else if (
+    decision.namespace === "control-everything.automation.v1" &&
+    exact(["namespace", "task_id", "text"]) &&
+    bounded("task_id") &&
+    decision.text === assignmentText
+  )
+    posted = {
+      assignment: {
+        namespace: decision.namespace,
+        task_id: text(decision.task_id),
+        text: assignmentText,
+      },
+    };
+  else if (
+    decision.namespace === "control-everything.automation.v1" &&
+    exact(["namespace", "task_id", "flow_id", "requirement_revision", "reason"]) &&
+    bounded("task_id") &&
+    bounded("flow_id") &&
+    revision("requirement_revision") &&
+    typeof decision.reason === "string" &&
+    heldReasons.has(decision.reason)
+  )
+    posted = {};
+  if (!posted || !eventId || !message || !actor || chat !== config.chatId) return fail();
+  const origin = new URL(config.hubOrigin);
+  if (!hubOriginAllowed(config.hubOrigin)) return fail();
+  if (!active() || signal?.aborted) throw new Error("Automation ingress account stopped");
+  if (Object.keys(posted).length === 0) return;
+  let response: Response;
+  try {
+    response = await fetch(`${origin.origin}/remote/producer/automation/receive`, {
+      method: "POST",
+      redirect: "error",
+      signal: signal
+        ? AbortSignal.any([signal, AbortSignal.timeout(15000)])
+        : AbortSignal.timeout(15000),
+      headers: { Authorization: `Bearer ${config.token}`, "Content-Type": "application/json" },
+      body: JSON.stringify({
+        producer_id: config.producerId,
+        event_id: eventId,
+        chat_id: chat,
+        message_id: message,
+        actor_open_id: actor,
+        ...posted,
+      }),
+    });
+  } catch {
+    throw new Error("Automation ingress transport failed");
+  }
+  if (!active() || signal?.aborted) throw new Error("Automation ingress account stopped");
+  if (response.status !== 200) throw new Error(`Automation ingress HTTP ${response.status}`);
+  let receipt: unknown;
+  try {
+    receipt = await response.json();
+  } catch {
+    return fail();
+  }
+  if (
+    !isRecord(receipt) ||
+    !text(receipt.id) ||
+    typeof receipt.state !== "string" ||
+    !["pending", "acknowledged"].includes(receipt.state)
+  )
+    return fail();
+}
+
+const PLAN = "按已审方案实现";
+const ACCEPTANCE: Record<string, string> = {
+  "这个版本通过，集成 develop": "approved",
+  "这一版要修改": "changes_requested",
+  "这一版不通过": "rejected",
+};
+const DECISION_KEYS = ["namespace", "decision_id", "task_id", "delivery_id", "expected_revision", "progress_revision", "verdict"];
+
+export function replyButton(text: string, card: unknown): Record<string, unknown> | null {
+  if (!isRecord(card) || !isRecord(card.body) || !Array.isArray(card.body.elements)) return null;
+  const elements = card.body.elements;
+  if (text === PLAN) {
+    const button = elements[1];
+    if (!isRecord(button) || !isRecord(button.value)) return null;
+    const value = button.value;
+    if (value.choice !== PLAN || value.namespace !== "control-everything.automation.v1") return null;
+    if (typeof value.flow_id !== "string" || !value.flow_id.trim() || !Number.isSafeInteger(value.requirement_revision) || Number(value.requirement_revision) < 0) return null;
+    return value;
+  }
+  const verdict = ACCEPTANCE[text];
+  if (!verdict) return null;
+  const matches = elements.filter((element) => {
+    if (!isRecord(element) || element.tag !== "button" || !isRecord(element.text) || element.text.content !== text) return false;
+    return isRecord(element.value) && element.value.verdict === verdict && element.value.namespace === "control-everything.automation.v1";
+  });
+  if (matches.length !== 1 || !isRecord(matches[0]) || !isRecord(matches[0].value)) return null;
+  const value = matches[0].value;
+  if (DECISION_KEYS.some((key) => value[key] === undefined) || value.verdict !== verdict) return null;
+  return value;
+}
+
+export async function receiveAutomationReply(params: {
+  event: { sender?: { sender_id?: { open_id?: string } }; message?: { content?: string; parent_id?: string; message_id?: string; chat_id?: string } };
+  config?: Ingress;
+  active: () => boolean;
+  signal?: AbortSignal;
+}): Promise<boolean> {
+  const message = params.event.message;
+  if (!params.config || !message || typeof message.content !== "string" || typeof message.parent_id !== "string") return false;
+  let text = "";
+  try {
+    const parsed = JSON.parse(message.content);
+    text = typeof parsed.text === "string" ? parsed.text.trim() : "";
+  } catch {
+    return false;
+  }
+  const parent = message.parent_id.trim();
+  const actor = params.event.sender?.sender_id?.open_id?.trim() ?? "";
+  if ((text !== PLAN && !ACCEPTANCE[text]) || !parent || !actor || !message.message_id || !message.chat_id) return false;
+  const origin = new URL(params.config.hubOrigin);
+  if (!hubOriginAllowed(params.config.hubOrigin)) return false;
+  let found: Response;
+  try {
+    found = await fetch(`${origin.origin}/remote/producer/automation/outbound/lookup`, {
+      method: "POST",
+      redirect: "error",
+      signal: params.signal ? AbortSignal.any([params.signal, AbortSignal.timeout(15_000)]) : AbortSignal.timeout(15_000),
+      headers: { Authorization: `Bearer ${params.config.token}`, "Content-Type": "application/json" },
+      body: JSON.stringify({ producer_id: params.config.producerId, message_id: parent }),
+    });
+  } catch {
+    return false;
+  }
+  if (found.status !== 200) return false;
+  let payload: unknown;
+  try {
+    payload = await found.json();
+  } catch {
+    return false;
+  }
+  if (!isRecord(payload)) return false;
+  const value = replyButton(text, payload.card);
+  if (!value) return false;
+  await receiveAutomationCard({
+    data: {
+      event_id: message.message_id,
+      operator: { open_id: actor },
+      context: { open_chat_id: message.chat_id, open_message_id: message.message_id },
+      action: { value },
+    },
+    config: params.config,
+    active: params.active,
+    signal: params.signal,
+  });
+  return true;
+}
