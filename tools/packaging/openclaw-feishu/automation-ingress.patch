+  response.resolve(new Response(JSON.stringify({ id: "receipt", state: "acknowledged" })));
+  await vi.waitFor(async () =>
+    expect(await queue.enqueue("identity-event", {})).toMatchObject({ kind: "completed" }),
+  );
+  await transport.invoke(data, { needCheck: false });
+  expect(fetch).toHaveBeenCalledTimes(1);
+  expect(ordinary).not.toHaveBeenCalled();
+});
+it.each([
+  { ...binding, actor_open_id: "forged" },
+  { ...binding, ...decision },
+  { ...binding, nonce: "" },
+  { ...binding, nonce: ["nonce"] },
+  { ...binding, challenge_id: "x".repeat(257) },
+])("rejects malformed identity binding %j", async (value) => {
+  const fetch = vi.spyOn(globalThis, "fetch");
