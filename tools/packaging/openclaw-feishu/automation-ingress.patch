@@ -0,0 +1,70 @@
+import { describe, expect, it, vi } from "vitest";
+import { runOutboundSender } from "./automation-outbound-sender.js";
+
+const config = {
+  hubOrigin: "https://hub.example.test",
+  producerId: "father",
+  chatId: "oc-chat",
+  token: "producer-fixture",
+};
+const card = { schema: "2.0", body: { elements: [{ tag: "markdown" }] } };
+const claimed = { id: "card-1", lease_id: "lease-1", card };
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), { status });
+}
+
+describe("outbound card sender", () => {
+  it("does not touch the network without ingress config", async () => {
+    const fetch = vi.spyOn(globalThis, "fetch");
+    const sendCard = vi.fn();
+    await runOutboundSender({ signal: new AbortController().signal, active: () => true, sendCard });
+    expect(fetch).not.toHaveBeenCalled();
+    expect(sendCard).not.toHaveBeenCalled();
+    fetch.mockRestore();
+  });
+
+  it("sends one claimed card and retries only the same receipt", async () => {
+    const controller = new AbortController();
+    let claims = 0;
+    let marks = 0;
+    vi.spyOn(globalThis, "fetch").mockImplementation(async (url) => {
+      const path = String(url);
+      if (path.endsWith("/claim")) {
+        claims += 1;
+        return json(claims === 1 ? claimed : { card: null });
+      }
+      marks += 1;
+      if (marks === 1) return json({ error: "busy" }, 503);
+      controller.abort();
+      return json({ id: claimed.id, state: "sent" });
+    });
+    const sendCard = vi.fn(async () => ({ messageId: "om-card" }));
+    await runOutboundSender({ config, signal: controller.signal, active: () => !controller.signal.aborted, sendCard });
+    expect(sendCard).toHaveBeenCalledTimes(1);
+    expect(sendCard.mock.calls[0]?.[0].uuid).toBe(claimed.id);
+    expect(sendCard.mock.calls[0]?.[0].card).toEqual(card);
+    const receipts = vi.mocked(fetch).mock.calls.filter((call) => String(call[0]).endsWith("/sent"));
+    expect(receipts).toHaveLength(2);
+    expect(JSON.parse(receipts[0]?.[1]?.body as string)).toEqual({
+      producer_id: "father", id: "card-1", lease_id: "lease-1", message_id: "om-card",
+    });
+    expect(receipts[0]?.[1]?.body).toBe(receipts[1]?.[1]?.body);
+    vi.restoreAllMocks();
+  });
+
+  it("does not mark or send again when the card has no message id", async () => {
+    const controller = new AbortController();
+    let claims = 0;
+    vi.spyOn(globalThis, "fetch").mockImplementation(async (url) => {
+      claims += 1;
+      if (claims > 1) controller.abort();
+      return json(claimed);
+    });
+    const sendCard = vi.fn(async () => ({ messageId: "" }));
+    await runOutboundSender({ config, signal: controller.signal, active: () => !controller.signal.aborted, sendCard });
+    expect(sendCard).toHaveBeenCalledTimes(1);
+    expect(vi.mocked(fetch).mock.calls.some((call) => String(call[0]).endsWith("/sent"))).toBe(false);
+    vi.restoreAllMocks();
+  });
+});
