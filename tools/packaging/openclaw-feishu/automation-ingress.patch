new file mode 100644
index 0000000..5dd018f
--- /dev/null
+++ b/extensions/feishu/src/automation-outbound-sender.ts
@@ -0,0 +1,110 @@
+import { hubOriginAllowed } from "./automation-card-ingress.js";
+import { isRecord } from "openclaw/plugin-sdk/channel-secret-basic-runtime";
+import type { ClawdbotConfig } from "../runtime-api.js";
+import { sendCardFeishu } from "./send.js";
+import type { ResolvedFeishuAccount } from "./types.js";
+
+const IDLE_MS = 2_000;
+
+type Ingress = NonNullable<ResolvedFeishuAccount["automationIngress"]>;
+type Claimed = { id: string; lease_id: string; card: Record<string, unknown> };
+
+function text(value: unknown): string {
+  return typeof value === "string" && value.trim() && value.length <= 256 && ![...value].some((char) => char.charCodeAt(0) < 32)
+    ? value
+    : "";
+}
+
+async function pause(signal: AbortSignal, ms: number): Promise<void> {
+  if (signal.aborted) return;
+  await new Promise<void>((resolve) => {
+    const timer = setTimeout(resolve, ms);
+    signal.addEventListener("abort", () => { clearTimeout(timer); resolve(); }, { once: true });
+  });
+}
+
+async function post(config: Ingress, path: string, body: Record<string, unknown>, signal: AbortSignal): Promise<Response> {
+  if (!hubOriginAllowed(config.hubOrigin)) throw new Error("Automation hub origin rejected");
+  const origin = new URL(config.hubOrigin);
+  return fetch(`${origin.origin}${path}`, {
+    method: "POST",
+    redirect: "error",
+    signal: AbortSignal.any([signal, AbortSignal.timeout(15_000)]),
+    headers: { Authorization: `Bearer ${config.token}`, "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  });
+}
+
+function readClaim(value: unknown): Claimed | null | undefined {
+  if (!isRecord(value) || !("card" in value)) return undefined;
+  if (value.card === null && Object.keys(value).length === 1) return null;
+  const keys = ["id", "lease_id", "card"];
+  if (Object.keys(value).length !== keys.length || keys.some((key) => !(key in value))) return undefined;
+  if (!text(value.id) || !text(value.lease_id) || !isRecord(value.card)) return undefined;
+  return { id: text(value.id), lease_id: text(value.lease_id), card: value.card };
+}
+
+async function mark(config: Ingress, signal: AbortSignal, claimed: Claimed, messageId: string): Promise<void> {
+  const body = { producer_id: config.producerId, id: claimed.id, lease_id: claimed.lease_id, message_id: messageId };
+  while (!signal.aborted) {
+    try {
+      const response = await post(config, "/remote/producer/automation/outbound/sent", body, signal);
+      if (response.status === 200) return;
+      if (response.status === 409) return;
+    } catch {
+      // The same receipt may be retried. The card send is not.
+    }
+    await pause(signal, IDLE_MS);
+  }
+}
+
+export async function runOutboundSender(params: {
+  config?: Ingress;
+  signal: AbortSignal;
+  active: () => boolean;
+  sendCard?: (input: { uuid: string; card: Record<string, unknown> }) => Promise<{ messageId?: string }>;
+  cfg?: ClawdbotConfig;
+  accountId?: string;
+}): Promise<void> {
+  const { config, signal } = params;
+  if (!config) return;
+  const sendCard = params.sendCard ?? (async (input) => {
+    const result = await sendCardFeishu({
+      cfg: params.cfg as ClawdbotConfig,
+      to: config.chatId,
+      accountId: params.accountId,
+      card: input.card,
+      uuid: input.uuid,
+    });
+    return { messageId: result.messageId };
+  });
+  const sent = new Map<string, string>();
+  while (params.active() && !signal.aborted) {
+    let claimed: Claimed | null | undefined;
+    try {
+      const response = await post(config, "/remote/producer/automation/outbound/claim", { producer_id: config.producerId }, signal);
+      claimed = response.status === 200 ? readClaim(await response.json()) : undefined;
+    } catch {
+      claimed = undefined;
+    }
+    if (!params.active() || signal.aborted) return;
+    if (!claimed) {
+      await pause(signal, IDLE_MS);
+      continue;
+    }
+    let messageId = sent.get(claimed.id) ?? "";
+    if (!sent.has(claimed.id)) {
+      try {
+        messageId = text((await sendCard({ uuid: claimed.id, card: claimed.card })).messageId);
+      } catch {
+        messageId = "";
+      }
+      sent.set(claimed.id, messageId);
+    }
+    if (!messageId) {
+      await pause(signal, IDLE_MS);
+      continue;
+    }
+    await mark(config, signal, claimed, messageId);
+  }
+}
