@@ -0,0 +1,64 @@
+import { describe, expect, it, vi } from "vitest";
+import { receiveAutomationReply } from "./automation-card-ingress.js";
+
+const config = {
+  hubOrigin: "https://hub.example.test",
+  producerId: "father",
+  chatId: "oc-chat",
+  token: "producer-fixture",
+};
+const planCard = {
+  schema: "2.0",
+  body: { elements: [{ tag: "markdown" }, { tag: "button", value: {
+    namespace: "control-everything.automation.v1", task_id: "task", flow_id: "flow-1",
+    requirement_revision: 3, choice: "按已审方案实现",
+  } }] },
+};
+
+function event(text: string, parent = "om-card") {
+  return {
+    sender: { sender_id: { open_id: "ou-operator" } },
+    message: {
+      message_id: "om-reply",
+      parent_id: parent,
+      chat_id: "oc-chat",
+      content: JSON.stringify({ text }),
+    },
+  };
+}
+
+describe("automation text replies", () => {
+  it("does not look up unrelated text", async () => {
+    const fetch = vi.spyOn(globalThis, "fetch");
+    await expect(receiveAutomationReply({
+      event: event("不错"), config, active: () => true,
+    })).resolves.toBe(false);
+    expect(fetch).not.toHaveBeenCalled();
+    fetch.mockRestore();
+  });
+
+  it("posts the plan release bound to the answered card", async () => {
+    vi.spyOn(globalThis, "fetch").mockImplementation(async (url) => {
+      if (String(url).endsWith("/lookup")) return new Response(JSON.stringify({ card: planCard }));
+      return new Response(JSON.stringify({ id: "receipt", state: "pending" }));
+    });
+    await expect(receiveAutomationReply({
+      event: event("按已审方案实现"), config, active: () => true,
+    })).resolves.toBe(true);
+    const posted = vi.mocked(fetch).mock.calls.find((call) => String(call[0]).endsWith("/receive"));
+    expect(JSON.parse(posted?.[1]?.body as string).plan_release).toEqual({
+      namespace: "control-everything.automation.v1", flow_id: "flow-1",
+      text: "按已审方案实现", requirement_revision: 3,
+    });
+    vi.restoreAllMocks();
+  });
+
+  it("does not post when the answered card has no matching button", async () => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(new Response(JSON.stringify({ card: null })));
+    await expect(receiveAutomationReply({
+      event: event("按已审方案实现"), config, active: () => true,
+    })).resolves.toBe(false);
+    expect(vi.mocked(fetch).mock.calls.some((call) => String(call[0]).endsWith("/receive"))).toBe(false);
+    vi.restoreAllMocks();
+  });
+});
