diff --git a/extensions/feishu/src/automation-config.test.ts b/extensions/feishu/src/automation-config.test.ts
new file mode 100644
index 00000000..d63bc147
--- /dev/null
+++ b/extensions/feishu/src/automation-config.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from "vitest";
+import { resolveFeishuAccount, resolveFeishuRuntimeAccount } from "./accounts.js";
+import { FeishuConfigSchema } from "./config-schema.js";
+
+const ingress = { hubOrigin: "https://hub.example.test", producerId: "father", chatId: "chat" };
+const account = {
+  appId: "app",
+  appSecret: "fixture",
+  automationIngress: ingress,
+  automationProducerToken: "producer-fixture",
+};
+
+describe("account-owned automation ingress", () => {
+  it("uses the normal account resolver for stored account key spelling", () => {
+    const cfg = { channels: { feishu: { accounts: { " Father ": account } } } };
+    expect(resolveFeishuRuntimeAccount({ cfg, accountId: "father" }).automationIngress).toEqual({
+      ...ingress,
+      token: "producer-fixture",
+    });
+  });
+  it("loads only explicit account ingress through the strict config entry", () => {
+    const feishu = FeishuConfigSchema.parse({
+      accounts: { father: account, mother: { appId: "mother", appSecret: "fixture" } },
+    });
+    const cfg = { channels: { feishu } };
+    expect(resolveFeishuRuntimeAccount({ cfg, accountId: "father" }).automationIngress).toEqual({
+      ...ingress,
+      token: "producer-fixture",
+    });
+    expect(
+      resolveFeishuRuntimeAccount({ cfg, accountId: "mother" }).automationIngress,
+    ).toBeUndefined();
+  });
+
+  it("rejects unsafe destinations and top-level inheritance", () => {
+    for (const hubOrigin of [
+      "not-a-url",
+      "",
+      "http://hub.example.test",
+      "https://u:p@hub.example.test",
+      "https://hub.example.test/path",
+      "https://hub.example.test?x=1",
+      "https://hub.example.test#x",
+    ]) {
+      expect(
+        FeishuConfigSchema.safeParse({
+          accounts: { father: { ...account, automationIngress: { ...ingress, hubOrigin } } },
+        }).success,
+      ).toBe(false);
+    }
+    expect(FeishuConfigSchema.safeParse({ automationIngress: ingress }).success).toBe(false);
+  });
+
+  it("rejects unresolved runtime secrets without exposing them in inspection", () => {
+    const cfg = {
+      channels: {
+        feishu: {
+          accounts: {
+            father: {
+              ...account,
+              automationProducerToken: {
+                source: "exec" as const,
+                provider: "fixture",
+                id: "producer",
+              },
+            },
+          },
+        },
+      },
+    };
+    expect(resolveFeishuAccount({ cfg, accountId: "father" }).automationIngress).toBeUndefined();
+    expect(() => resolveFeishuRuntimeAccount({ cfg, accountId: "father" })).toThrow(
+      "unresolved SecretRef",
+    );
+  });
+
+  it("fails runtime activation when the configured ingress has no producer credential", () => {
+    const cfg = {
+      channels: {
+        feishu: {
+          accounts: { father: { appId: "app", appSecret: "fixture", automationIngress: ingress } },
+        },
+      },
+    };
+    expect(() => resolveFeishuRuntimeAccount({ cfg, accountId: "father" })).toThrow(
+      "automationProducerToken",
+    );
+  });
+});
