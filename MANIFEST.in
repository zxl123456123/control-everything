include web/workspace/task-center.js
include web/workspace/project-space.js web/workspace/execution.js web/workspace/observation.js
include web/workspace/news.js web/workspace/quota.js
include web/workspace/news-reader.html web/workspace/news-reader.css web/workspace/news-reader.js
